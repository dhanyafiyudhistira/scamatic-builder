MONGO_URI=mongodb+srv://USER:PASSWORD@HOST/DATABASE
# API cold-start recovery. The HTTP listener stays alive while readiness
# remains unavailable. 0 attempts means retry indefinitely.
API_MONGO_STARTUP_MAX_ATTEMPTS=0
API_MONGO_RETRY_INITIAL_MS=500
API_MONGO_RETRY_MAX_MS=10000
# Readiness returns HTTP 503 within this deadline while connection continues.
MONGO_READINESS_TIMEOUT_MS=2500

# Worker cold-start recovery. 0 attempts means retry indefinitely, with the
# delay capped by CONNECTOR_MONGO_RETRY_MAX_MS.
CONNECTOR_MONGO_STARTUP_MAX_ATTEMPTS=0
CONNECTOR_MONGO_RETRY_INITIAL_MS=500
CONNECTOR_MONGO_RETRY_MAX_MS=10000

# Dedicated Chart telemetry storage. Use a different MongoDB cluster from
# MONGO_URI in production so telemetry traffic cannot exhaust the control plane.
CHART_MONGO_URI=mongodb+srv://USER:PASSWORD@TELEMETRY_HOST/scamatic_telemetry
CHART_MONGO_DB=scamatic_telemetry
CHART_MONGO_COLLECTION=chart_samples
CHART_MONGO_RETENTION_DAYS=30
CHART_MONGO_BATCH_SIZE=500
CHART_MONGO_FLUSH_MS=250
CHART_MONGO_MAX_QUEUE=20000
CHART_MONGO_MAX_POOL_SIZE=20
CHART_HISTORY_MAX_BOOTSTRAP_POINTS=10000
# Required in production. The hostname in the write-only URI must be listed.
CHART_MONGO_ALLOWED_HOSTS=telemetry.example.mongodb.net
# Optional explicit exception for an approved private telemetry hostname.
CHART_MONGO_ALLOWED_PRIVATE_HOSTS=
# Development escape hatch only. Never enable this in production.
CHART_MONGO_ALLOW_SHARED_CLUSTER=false

# Required on production. Local development defaults are documented in README.
SCADA_ADMIN_EMAIL=admin@scada.local
SCADA_ADMIN_PASSWORD=replace-with-a-strong-password
SCADA_WORKSPACE_ID=default
SCADA_SESSION_TTL_SECONDS=43200
SCADA_SESSION_IDLE_SECONDS=1800
SCADA_MAX_AUTH_SESSIONS=10
APP_ORIGIN=https://builder.example.com

# Connector platform. Keep both feature flags off until staging is signed off.
CONNECTOR_PLATFORM_ENABLED=false
CONNECTOR_LIVE_COMMANDS_ENABLED=false
# Vercel defaults to serverless; persistent worker deployments default to worker.
CONNECTOR_EXECUTION_MODE=serverless
CONNECTOR_POLL_INTERVAL_MS=2000
LEGACY_DIRECT_THINGSBOARD_ENABLED=false
CONNECTOR_ENVIRONMENT=staging
CONNECTOR_STREAM_PORT=3002
CONNECTOR_STREAM_PUBLIC_URL=wss://connectors.example.com/runtime-stream
SCADA_RUNTIME_SESSION_SECONDS=1800
SCADA_STREAM_TICKET_SECONDS=60
SCADA_MAX_RUNTIME_SESSIONS=5
# One runtime per ThingsBoard device owns RPC polling at a time; lifecycle records retain
# enough state to resume telemetry/response delivery after a transient failure.
SIMULATION_RESPONDER_LEASE_MS=35000
SIMULATION_RPC_RETENTION_MS=86400000
# 32 random bytes encoded as base64. Never commit the real value.
SCADA_CONNECTOR_MASTER_KEY=
# Required in production to prevent connector SSRF (comma-separated hostnames).
CONNECTOR_ALLOWED_HOSTS=thingsboard.example.com
# Optional explicit exception for approved private ThingsBoard hostnames.
CONNECTOR_ALLOWED_PRIVATE_HOSTS=

# Optional project scope for the isolated legacy telemetry history screen.
VITE_LEGACY_PROJECT_ID=
