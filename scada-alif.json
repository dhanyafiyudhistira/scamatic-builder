        "name": "Decode RPCLevel_Air",
        "func": "// Memastikan perintah RPC yang masuk adalah method yang benar dari slider\nif (msg.payload.method === \"setLevel_Air\") {\n    \n    // Ambil nilai angkanya\n    msg.payload = msg.payload.params;\n    \n    // Arahkan ke tag PLC S7\n    msg.topic = \"Level_Air\";\n    \n    return msg;\n}",
