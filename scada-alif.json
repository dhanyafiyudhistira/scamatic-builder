    {
        "id": "2b0f51ec1efe711b",
        "type": "function",
        "z": "8f60ab369a41f39a",
        "name": "Decode RPCV106",
        "func": "let method = msg.payload.method;\nlet value = (msg.payload.params == true || msg.payload.params == \"true\" || msg.payload.params == 1);\n\nswitch(method){\n\ncase 'setM_ManualV106':\nmsg.topic='M_ManualV106';\nmsg.payload= value;\nreturn msg;\n\ndefault:\nreturn null;\n}",
        "outputs": 1,
        "timeout": "",
        "noerr": 0,
        "initialize": "",
