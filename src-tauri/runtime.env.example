# Machine configuration for SCAMATIC Local Runtime.
# Copy this file to C:\ProgramData\SCAMATIC\runtime.env and restrict edits to administrators.
# The installer never embeds or replaces runtime.env.

MONGO_URI=mongodb://127.0.0.1:27017/scamatic
SCADA_CONNECTOR_MASTER_KEY=
# Rotation only: set the old key here temporarily while the new key above is primary.
# Clear this after scripts/rotate-connector-master-key.js completes successfully.
SCADA_CONNECTOR_PREVIOUS_MASTER_KEYS=

# Optional first local owner bootstrap. Change these before operational use.
SCADA_ADMIN_EMAIL=admin@scada.local
SCADA_ADMIN_PASSWORD=
SCADA_WORKSPACE_ID=local

# Connector allowlist. Values are comma-separated hostnames only: no scheme, credentials, port, or path.
# Private-target access remains disabled while the corresponding list is empty.
CONNECTOR_ALLOWED_HOSTS=
CONNECTOR_ALLOWED_PRIVATE_HOSTS=

# Workspace Chart archive allowlist. The full write-only URI is configured later inside Builder.
CHART_MONGO_ALLOWED_HOSTS=
CHART_MONGO_ALLOWED_PRIVATE_HOSTS=
# Production deployments should keep Chart telemetry isolated from the control-plane MongoDB cluster.
CHART_MONGO_ALLOW_SHARED_CLUSTER=false

# Isaac remains fail-safe and opt-in. Project selection and server readiness still decide the engine.
SCADA_RUST_SHADOW_ENABLED=true
SCADA_ISAAC_CANARY_ENABLED=false
